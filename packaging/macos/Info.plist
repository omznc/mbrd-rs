<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundle macOS needs to treat this as an application rather than as a
  program that happens to open a window. A bare Mach-O runs from a terminal,
  but it has no name in the menu bar, no Dock identity, and cannot be
  double-clicked out of Applications. __VERSION__ is substituted by the
  release workflow from the workspace version.

  CFBundleDocumentTypes declares `.mbrd`, and it may only do so because
  `main.rs` now listens for the Apple Event the Finder sends — `on_open_urls`.
  The two go together and must stay together: declaring the type without the
  hook would make the Finder offer this app for a board and then have the app
  show the demonstration board instead, which is worse than not being offered.
-->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>mbrd</string>
	<key>CFBundleDisplayName</key>
	<string>mbrd</string>
	<key>CFBundleExecutable</key>
	<string>mbrd</string>
	<key>CFBundleIconFile</key>
	<string>mbrd</string>
	<key>CFBundleIdentifier</key>
	<string>com.omznc.mbrd</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<!-- The floor gpui's own Metal shaders are compiled against. -->
	<key>LSMinimumSystemVersion</key>
	<string>10.15.7</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Not a background agent: without this the app can launch without ever
	     coming to the front, which on a canvas you are meant to draw on reads
	     as the app having failed to start. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<!-- What a board is, so the Finder can offer this app for one. `Owner`
	     rather than `Alternate` because this is the application that defines
	     the format, and `Editor` because opening one here is not a preview. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>mbrd board</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.omznc.mbrd.board</string>
			</array>
		</dict>
	</array>
	<!-- And what that identifier means, declared once here because nobody
	     else defines it. Conforming to `public.data` and `public.archive` is
	     honest: a `.mbrd` is a zip with a manifest in it. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.omznc.mbrd.board</string>
			<key>UTTypeDescription</key>
			<string>mbrd board</string>
			<key>UTTypeIconFile</key>
			<string>mbrd</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mbrd</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
